# Copia este archivo como .env y completa los valores del proyecto de Supabase
# (Supabase > Project Settings > API). Solo la clave pública (anon / publishable).
# La clave service_role NUNCA va en el frontend ni en el repositorio.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-clave-publica

# Dominio interno para convertir el nombre de usuario en correo de Supabase Auth
# (ej. el usuario "bodega" inicia sesión como bodega@pisosburuca.local)
VITE_AUTH_DOMAIN=pisosburuca.local
